# =============================================================================
# NumbyAI Server — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values as needed.
#   cp .env.example .env
#
# All variables below have sensible defaults for local development.
# Only DATABASE_URL and SECRET_KEY require attention for production.
# =============================================================================

# -- Database -----------------------------------------------------------------
# SQLite (default, zero-config for local dev):
DATABASE_URL=sqlite:///./finance_recon.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/numbyai

# -- Server -------------------------------------------------------------------
# IMPORTANT: Change this to a random secret in production.
SECRET_KEY=dev-only-not-for-production

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to "production" to enforce strict validation (e.g. SECRET_KEY check).
ENVIRONMENT=development

# -- LLM Provider -------------------------------------------------------------
# Leave unset — defaults to Ollama.
# LLM_PROVIDER=ollama
# LLM_TIMEOUT_SECONDS=300

# -- Ollama (local LLM) ------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Set to true/false to force thinking mode on/off; leave unset to omit.
# OLLAMA_THINK=false
# Context window size for Ollama. Leave unset to use model default (~32k for qwen3.5:9b).
# Lower values (e.g. 16384) may improve speed and quality for smaller batches.
# OLLAMA_NUM_CTX=32768
CATEGORIZATION_BATCH_SIZE=20
CATEGORIZATION_MAX_WORKERS=5

# -- MiniMax (cloud LLM — optional) -------------------------------------------
# To use MiniMax instead of Ollama, set LLM_PROVIDER=minimax and provide a key.
# MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M2.5

# -- Auth0 (optional — leave unset to use the built-in test user) ------------
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_AUDIENCE=

# -- Supabase (optional — alternative auth provider) -------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
